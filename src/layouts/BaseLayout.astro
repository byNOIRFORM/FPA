---
import "../styles/tokens.css";
import "../styles/global.css";
import "lenis/dist/lenis.css";
import Loader from "../components/Loader.astro";
import ContactForm from "../components/ContactForm.astro";
import SideNav from "../components/SideNav.astro";
import PageTransition from "../components/PageTransition.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import GridOverlay from "../components/GridOverlay.astro";
import Nav from "../components/Nav.astro";
import { home, localizedHrefs, type Lang, LANGS } from "../i18n/home";

interface Props {
  title?: string;
  description?: string;
  /** Emit robots noindex — error pages (404) that shouldn't be indexed. */
  noindex?: boolean;
  /** Show the intro house-loader. True on the landing; subpages
   *  (e.g. /sluzby) pass false so they don't replay the full intro
   *  on every navigation. */
  loader?: boolean;
  /** Document language for <html lang> — SK / CZ / EN landing pages. */
  lang?: Lang;
  /** Shared nav variant — "home" (landing) or "sub" (subpages). */
  navVariant?: "home" | "sub";
  /** Marks the current-page primary nav link on subpages. */
  navActive?: "about" | "projects" | "services";
  /** Selector the nav theme-switch observes (transparent while in view,
   *  cream once scrolled past). Defaults per variant inside Nav; project
   *  pages pass ".phero" so the bar reads over the hero photo. */
  navBoundary?: string;
}

const {
  title = "Atelier",
  description = "Architektonický ateliér",
  noindex = false,
  loader = true,
  lang = "sk",
  navVariant = "home",
  navActive,
  navBoundary,
} = Astro.props;

/* ===== SEO — canonical, hreflang alternates, Open Graph, JSON-LD =====
   Absolute URLs come off `site` in astro.config (fottapopadic.sk). The
   language alternates reuse localizedHrefs so canonical + hreflang stay
   consistent with the same trailing-slash form Astro serves. */
const alt = localizedHrefs(Astro.url.pathname);
const abs = (path: string): string => new URL(path, Astro.site).href;
// PAGE urls follow Astro's directory build format (trailing slash) — the
// homepage /cz, /en alternates otherwise drop it and mismatch the served
// /cz/, /en/. Assets (og-image, favicon) keep raw `abs`, no slash.
const pageUrl = (path: string): string =>
  abs(path === "/" ? "/" : path.replace(/\/?$/, "/"));
const canonical = pageUrl(alt[lang]);
const ogImage = abs("/og-image.jpg");
const SITE_NAME = "Fotta Popadič architekt";
// hreflang uses the LANGUAGE code — Czech is "cs", not the country "cz".
const HREFLANG: Record<Lang, string> = { sk: "sk", cz: "cs", en: "en" };
const OG_LOCALE: Record<Lang, string> = { sk: "sk_SK", cz: "cs_CZ", en: "en_US" };
const ogLocaleAlternates = LANGS.filter((l) => l !== lang).map((l) => OG_LOCALE[l]);

/* LocalBusiness structured data — real atelier info from the footer.
   Two branches (Bardejov + Košice) as departments with their own
   address + geo, so Google Maps/knowledge panel can place both. */
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://fottapopadic.sk/#organization",
  name: SITE_NAME,
  url: "https://fottapopadic.sk/",
  logo: abs("/favicon.svg"),
  image: ogImage,
  email: "atelier@fottapopadic.sk",
  telephone: "+421907183302",
  foundingDate: "1998",
  founder: { "@type": "Person", name: "Pavol Fotta" },
  areaServed: ["SK", "CZ"],
  sameAs: [
    "https://www.instagram.com/fotta_popadic_architekt",
    "https://www.facebook.com/fotta.popadic",
  ],
  department: [
    {
      "@type": "ProfessionalService",
      name: "Fotta Popadič architekt — Bardejov",
      telephone: "+421907183302",
      email: "atelier@fottapopadic.sk",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Priemyselná 3767",
        addressLocality: "Bardejov",
        postalCode: "085 01",
        addressCountry: "SK",
      },
      geo: { "@type": "GeoCoordinates", latitude: 49.3041466, longitude: 21.3043425 },
    },
    {
      "@type": "ProfessionalService",
      name: "Fotta Popadič architekt — Košice",
      telephone: "+421907183302",
      email: "atelier@fottapopadic.sk",
      address: {
        "@type": "PostalAddress",
        streetAddress: "Dominikánske námestie 590/6",
        addressLocality: "Košice",
        postalCode: "040 01",
        addressCountry: "SK",
      },
      geo: { "@type": "GeoCoordinates", latitude: 48.7207062, longitude: 21.2539693 },
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    {/* viewport-fit=cover lets full-bleed sections (hero, intro) extend
        under the notch / home indicator instead of leaving a cream safe-area
        band; the nav + side-nav already pad with env(safe-area-inset-*). */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {/* ===== SEO ===== */}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    {/* Language alternates — same page in SK / CZ / EN, x-default → SK. */}
    <link rel="alternate" hreflang={HREFLANG.sk} href={pageUrl(alt.sk)} />
    <link rel="alternate" hreflang={HREFLANG.cz} href={pageUrl(alt.cz)} />
    <link rel="alternate" hreflang={HREFLANG.en} href={pageUrl(alt.en)} />
    <link rel="alternate" hreflang="x-default" href={pageUrl(alt.sk)} />

    {/* Open Graph — link/social previews (FB, LinkedIn, iMessage…). */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE_NAME} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {ogLocaleAlternates.map((l) => (
      <meta property="og:locale:alternate" content={l} />
    ))}

    {/* Twitter / X card. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* LocalBusiness structured data. */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    {/* iOS/Android browser-chrome tint. In portrait Safari the status-bar
        strip is CHROME, not page — content can never paint behind the
        notch, and without this meta Safari fills the strip with the page
        background (the cream band bug over photo heroes). nav.ts keeps the
        value in sync at runtime: photo tone while the nav is transparent
        over a hero, live --bg once scrolled to the cream panel. */}
    <meta name="theme-color" content="#FAF9F6" />

    {/* THEME — resolve light/dark BEFORE first paint to avoid a flash.
        Order of truth: explicit stored choice → OS preference → light.
        Sets data-theme on <html> synchronously; theme-toggle.ts keeps
        it in sync afterwards. */}
    <script is:inline>
      try {
        var stored = localStorage.getItem("fpa:theme");
        var theme =
          stored ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        document.documentElement.setAttribute("data-theme", theme);
        if (theme === "dark") {
          var tc = document.querySelector('meta[name="theme-color"]');
          if (tc) tc.setAttribute("content", "#222222");
        }
      } catch (e) {}
    </script>

    {/* Page-transition arrival flag — must run synchronously BEFORE
        first paint so the new document is dark from its very first
        frame. The cover is applied via INLINE styles + an injected
        <style> element (NOT the bundled stylesheet): the dev server
        loads CSS through JS after first paint, which is what caused
        the white flash between pages. page-transition.ts cleans all
        of this up once its curtain holds the screen.

        Covered arrivals are (a) link navigations that played the exit
        sweep (sessionStorage flag), and (b) back/forward FULL RELOADS —
        without the cover those flash the raw page (no exit sweep ever
        covered the screen). bfcache restores never run this script, so
        native instant back-swipes stay untouched. */}
    <script is:inline>
      try {
        var pt = sessionStorage.getItem("fpa:pt");
        if (pt) sessionStorage.removeItem("fpa:pt");
        var bf = false;
        try {
          var nav = performance.getEntriesByType("navigation")[0];
          // WebKit doesn't expose the navigation entry until the load
          // event, so in <head> the array is empty — fall back to the
          // legacy (deprecated but synchronous) API there. type 2 =
          // TYPE_BACK_FORWARD.
          bf = nav
            ? nav.type === "back_forward"
            : !!(performance.navigation && performance.navigation.type === 2);
        } catch (e2) {}
        if (pt || bf) {
          var d = document.documentElement;
          d.setAttribute("data-pt", "");
          d.style.background = "#222";
          var s = document.createElement("style");
          s.id = "pt-boot";
          s.textContent = "body{visibility:hidden}";
          document.head.appendChild(s);
        }
      } catch (e) {}
    </script>

    {/* Favicon — SVG house from the loader. Embedded
        prefers-color-scheme rule inverts the stroke on dark browser
        themes. Modern browsers (95%+ traffic) support SVG favicons;
        no ICO fallback ships intentionally — old Astro default ICO
        was deleted to prevent cached-favicon confusion. The ?v=2
        query busts any stale browser cache from the previous icon. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=5" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />

    {/* Switzer = project default sans (Fontshare). Loads regular,
        regular italic, medium, medium italic, semibold, bold.
        (Fontshare convention: .1 suffix on weight = italic variant —
         401 = Regular Italic, 501 = Medium Italic.) */}
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=switzer@400,401,500,501,600,700&display=swap"
    />

    {/* Display serif + mono kept for headings and labels. */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    {/* Preload hero — image must be decoded by the time the loader
        curtain rises so the Ken Burns scale-settle plays smoothly
        without bitmap decoding hitching on first paint. */}
    <link rel="preload" as="image" href="/images/hero.jpg" />
  </head>
  <body data-loader-active={loader ? "" : undefined}>
    {loader && <Loader />}

    {/* Shared site nav — rendered at the page ROOT so it is never trapped
        inside a section's stacking context (e.g. the sticky intro on
        /sluzby, where a nested nav rendered under later sections). One
        nav for the whole site. */}
    <Nav lang={lang} variant={navVariant} active={navActive} boundary={navBoundary} />

    {/* Custom cursor — circle ring + small square in the centre.
        Hidden on touch / small screens via CSS in global.css. */}
    <div class="cursor" id="cursor" aria-hidden="true">
      <span class="cursor-square"></span>
      <span class="cursor-ring" data-view-label={home[lang].cursorView}></span>
    </div>

    <slot />

    {/* Contact form lives at the layout level so any CTA on any
        page can open it via [data-open-contact]. */}
    <ContactForm lang={lang} />

    {/* Mobile side navigation (≤767px) — opened by the nav "Menu"
        button via [data-open-menu]. Hidden on tablet/desktop. */}
    <SideNav lang={lang} />

    {/* Page-transition curtain — sweeps over the page on internal
        navigation; see scripts/page-transition.ts. */}
    <PageTransition />

    {/* Light/dark switch — fixed bottom-right, on every page. */}
    <ThemeToggle lang={lang} />

    {/* Structure easter egg — press-and-hold the logo to reveal the
        12-column grid (see GridOverlay + scripts/grid-reveal.ts). */}
    <GridOverlay />

    <script>
      import { setupGsap } from "../scripts/gsap-setup";
      import { initThemeToggle } from "../scripts/theme-toggle";
      import { initGridReveal } from "../scripts/grid-reveal";
      import { initLoader } from "../scripts/loader";
      import { initHero } from "../scripts/hero";
      import { initAbout } from "../scripts/about";
      import { initWorks } from "../scripts/works";
      import { initProject } from "../scripts/project";
      import { initProjectsPage } from "../scripts/projects-page";
      import { initAboutPage } from "../scripts/about-page";
      import { initServices } from "../scripts/services";
      import { initLeaders } from "../scripts/leaders";
      import { initFooter } from "../scripts/footer";
      import { initNav } from "../scripts/nav";
      import { initContactForm } from "../scripts/contact-form";
      import { initSideNav } from "../scripts/side-nav";
      import { initPageTransition } from "../scripts/page-transition";
      import { initNotFound } from "../scripts/not-found";
      import { initLoopVideos } from "../scripts/loop-video";
      import { initBuildingTypes } from "../scripts/building-types";
      setupGsap();
      initHero();
      initAbout();
      initWorks();
      initProject();
      initProjectsPage();
      initAboutPage();
      initServices();
      initLeaders();
      initFooter();
      initNav();
      initContactForm();
      initSideNav();
      initPageTransition();
      initNotFound();
      initLoopVideos();
      initBuildingTypes();
      initThemeToggle();
      initGridReveal();
      initLoader();
    </script>
  </body>
</html>
