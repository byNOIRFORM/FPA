---
/**
 * AboutPage — the /o-nas page (Figma "oNás", node 3227:348). Built section
 * by section as the design lands; current spine:
 *
 *   hero (photo + word-mask title) → word-scrub intro → "Počiatky
 *   ateliéru" (label · two text columns · photo + caption) → photo story →
 *   team word-scrub → Pavol (photo + bio) → Tomáš + Dominik (bio + photo
 *   pair) → "Náš tím" editorial grid → "Čo hovoria naši klienti" drag
 *   carousel → footer
 *
 * Motion in scripts/about-page.ts — everything reuses the site's motion
 * language 1:1:
 *   - Hero: homepage hero choreography (image settle 1.1→1, words at 0.85s,
 *     Ken Burns yo-yo after)
 *   - Intros: per-word colour scrub (--reveal)
 *   - Origins/team texts + photos: clip-path curtain on scroll-in (Works
 *     row-1 pattern); photo pairs/rows unroll in reading order
 *   - Team grid: static portraits, scroll reveal on row 1 only
 *   - Testimonials: the shared drag gallery with per-slide snap + a
 *     masked-rise counter; NO auto-rotation (user-driven motion only)
 */
import Footer from "./Footer.astro";
import DragCursor from "./DragCursor.astro";
import { type Lang } from "../i18n/home";
import { aboutPage } from "../i18n/about-page";
import { projectsUI } from "../i18n/projects";
import {
  fetchTeamMembers,
  fetchTeamSettings,
  fetchTestimonials,
  imgSrc,
  portraitSrc,
} from "../lib/sanity";

interface Props {
  lang?: Lang;
}
const { lang = "sk" } = Astro.props;
const t = aboutPage[lang];

const introWords = t.intro.split(" ");
const teamIntroWords = t.team.intro.split(" ");

// Lang-agnostic photos (same convention as the story blocks): duo order
// matches t.team.duo.members (Dominik left, Tomáš right).
const duoImages = ["/images/about/dominik.jpg", "/images/about/tomas.jpg"];

// Team grid (Figma oNás_V2 3393:216) — ONE portrait per member (the hover
// second-portrait treatment was removed 2026-07-14). A `null` renders the
// dark placeholder tile (the CMS case "member added before the photoshoot").
//
// CMS: the roster is the FIRST Sanity-managed content (test rollout,
// 2026-07-16; schema + Studio live in studio/). Members come from Sanity
// at build time; when Sanity is unconfigured/unreachable the hardcoded
// i18n list + local photos below take over — the build never breaks on
// the CMS.
const memberImages: (string | null)[] = [
  "/images/about/team-1.jpg",
  "/images/about/team-2.jpg",
  "/images/about/team-3.jpg",
  "/images/about/team-4.jpg",
  "/images/about/team-5.jpg",
  "/images/about/team-6.jpg",
  "/images/about/team-7.jpg",
  "/images/about/team-8.jpg",
];
const sanityMembers = await fetchTeamMembers();
// Preklad zo splošteného Sanity dokumentu: CZ/EN s fallbackom na SK
// (prázdny preklad nikdy nevyrenderuje prázdny string).
const pickLang = (sk: string, cz?: string | null, en?: string | null): string =>
  (lang === "cz" ? cz : lang === "en" ? en : sk) || sk;
const teamMembers: { name: string; role: string; image: string | null }[] =
  sanityMembers?.map((m) => ({
    name: m.name,
    role: pickLang(m.roleSk, m.roleCz, m.roleEn),
    image: m.portraitUrl ? portraitSrc(m.portraitUrl) : null,
  })) ?? t.team.members.map((m, i) => ({ ...m, image: memberImages[i] ?? null }));

// Rows of three in a 4-column raster; the empty cell alternates — odd rows
// skip column 3, even rows skip column 2 (the Figma editorial rhythm).
const teamCols = [
  [1, 2, 4],
  [1, 3, 4],
];
type TeamTile = {
  name: string;
  role: string;
  image: string | null;
  col: number;
  careers?: boolean;
};
const memberRows: TeamTile[][] = [];
teamMembers.forEach((m, i) => {
  const r = Math.floor(i / 3);
  (memberRows[r] ??= []).push({
    ...m,
    col: teamCols[r % 2][i % 3],
  });
});

// The "Voľné miesto" careers tile closes the roster — an outlined empty
// frame at the next free grid slot, arcing on hover and linking to the
// job posting. Driven by the Studio singleton "Nastavenia tímu"
// (2026-07-16): the checkbox drops the tile entirely, the URL points at
// the current job post. Fallback = today's behaviour (tile on, the
// long-standing profesia.sk link, same URL as the footer's Kariéra).
const CAREERS_URL_FALLBACK =
  "https://www.profesia.sk/praca/fotta-popadic-architekt/O5302133";
const teamSettings = await fetchTeamSettings();
const careersOpen = teamSettings?.careersOpen ?? true;
const CAREERS_URL = teamSettings?.careersUrl || CAREERS_URL_FALLBACK;
if (careersOpen) {
  const ci = teamMembers.length;
  const cr = Math.floor(ci / 3);
  (memberRows[cr] ??= []).push({
    ...t.team.careers,
    image: null,
    col: teamCols[cr % 2][ci % 3],
    careers: true,
  });
}

// Testimonials — the slide image is OPTIONAL (the fluid.glass pattern,
// Michal 2026-07-15): a CLIENT PORTRAIT renders when the client supplied
// one (with consent); `null` renders a clean text-only pull-quote slide
// and nothing shifts (the quote is pinned to its grid column). Current
// mix (3 with / 2 without, Michal 2026-07-15): placeholder portraits sit
// on the INVENTED personas only — Jozef Marcin is a real reviewer, so he
// stays photo-less until his real photo (+consent) arrives.
//
// CMS: testimonials come from Sanity at build time ("Referencie klientov",
// drag & drop order); when Sanity is unconfigured/unreachable the
// hardcoded i18n quotes + local photos below take over — the build never
// breaks on the CMS. Photo renders at byline scale (max 160px) → w=400
// covers retina.
const testimonialImages: (string | null)[] = [
  null, // Jozef Marcin — real person, no placeholder face
  "/images/about/ref-valko.jpg",
  "/images/about/ref-vargova.jpg",
  "/images/about/ref-simko.jpg",
  null, // Lenka Kravcová — the text-only variant stays exercised
];
const sanityTestimonials = await fetchTestimonials();
const testimonials: { quote: string; name: string; role: string; image: string | null }[] =
  sanityTestimonials?.map((x) => ({
    quote: pickLang(x.quoteSk, x.quoteCz, x.quoteEn),
    name: x.name,
    role: pickLang(x.roleSk, x.roleCz, x.roleEn),
    image: x.photoUrl ? imgSrc(x.photoUrl, 400) : null,
  })) ??
  t.testimonials.items.map((item, i) => ({
    ...item,
    image: testimonialImages[i] ?? null,
  }));
const testimonialCount = String(testimonials.length).padStart(2, "0");
const dragLabel = projectsUI[lang].dragLabel;
---

<article class="apage">
  {/* ===== HERO — photo + word-mask title (homepage choreography) ===== */}
  <header class="ahero" aria-label={t.heroTitle}>
    <div class="ahero-media">
      <img src="/images/about/hero.jpg" alt="" fetchpriority="high" />
    </div>
    <div class="ahero-scrim" aria-hidden="true"></div>
    <div class="awrap ahero-inner">
      <h1 class="ahero-title">
        {t.heroTitle.split(" ").map((w) => (
          <span class="ahero-title-mask"><span class="ahero-title-word">{w}</span></span>
        ))}
      </h1>
    </div>
  </header>

  {/* ===== INTRO — per-word colour scrub + rule ===== */}
  <section class="aintro">
    <div class="awrap aintro-inner">
      <p class="aintro-text">
        {introWords.map((w) => (
          <>
            <span class="aword">{w}</span>{" "}
          </>
        ))}
      </p>
      <div class="adivider"></div>
    </div>
  </section>

  {/* ===== POČIATKY ATELIÉRU — label · two columns · photo ===== */}
  <section class="aorigins">
    <div class="awrap aorigins-grid">
      <h2 class="aorigins-label" data-reveal>{t.origins.label}</h2>

      <div class="aorigins-content">
        <div class="aorigins-cols">
          <div class="aorigins-col" data-reveal>
            {t.origins.col1.map((p) => <p>{p}</p>)}
          </div>
          <div class="aorigins-col" data-reveal>
            {t.origins.col2.map((p) => <p>{p}</p>)}
          </div>
        </div>

        <figure class="aorigins-figure">
          {/* Curtain reveal on scroll-in — homepage Works row-1 pattern. */}
          <div class="amedia" data-reveal style="aspect-ratio: 915 / 456">
            <img src="/images/about/pociatky.jpg" alt={t.origins.caption} loading="lazy" />
          </div>
          <figcaption class="aorigins-caption" data-reveal>{t.origins.caption}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  {/* ===== PRÍBEH V OBRAZOCH — pair row (tall 445 + mid 680) then the wide
      1147 photo aligned right; every photo reveals with the same curtain +
      caption rise as the "Počiatky" photo above. Divider closes here. ===== */}
  <section class="astory">
    <div class="awrap astory-row">
      <figure class="astory-fig astory-fig--tall">
        <div class="amedia" data-reveal style="aspect-ratio: 445 / 620">
          <img src="/images/about/kontrola.jpg" alt={t.story[0].alt} loading="lazy" />
        </div>
        <figcaption class="astory-caption" data-reveal>{t.story[0].caption}</figcaption>
      </figure>
      <figure class="astory-fig astory-fig--mid">
        <div class="amedia" data-reveal style="aspect-ratio: 680 / 482">
          <img src="/images/about/diskusia.jpg" alt={t.story[1].alt} loading="lazy" />
        </div>
        <figcaption class="astory-caption" data-reveal>{t.story[1].caption}</figcaption>
      </figure>
    </div>
    {/* Second pair — mirrored composition: portrait 563 offset 117 from the
        left edge, landscape 563 flush right (Figma frame "2"). */}
    <div class="awrap astory-row">
      <figure class="astory-fig astory-fig--offset">
        <div class="amedia" data-reveal style="aspect-ratio: 563 / 730">
          <img src="/images/about/model.jpg" alt={t.story[2].alt} loading="lazy" />
        </div>
        <figcaption class="astory-caption" data-reveal>{t.story[2].caption}</figcaption>
      </figure>
      <figure class="astory-fig astory-fig--flush">
        <div class="amedia" data-reveal style="aspect-ratio: 563 / 402">
          <img src="/images/about/vzorky.jpg" alt={t.story[3].alt} loading="lazy" />
        </div>
        <figcaption class="astory-caption" data-reveal>{t.story[3].caption}</figcaption>
      </figure>
    </div>
    <div class="awrap astory-widerow">
      <figure class="astory-fig astory-fig--wide">
        <div class="amedia" data-reveal style="aspect-ratio: 1147 / 584">
          <img src="/images/about/stavba.jpg" alt={t.story[4].alt} loading="lazy" />
        </div>
        <figcaption class="astory-caption" data-reveal>{t.story[4].caption}</figcaption>
      </figure>
    </div>
  </section>

  {/* ===== TÍM — word-scrub intro (Figma "Sekcia 4"): left-aligned, 3em
      editorial indent like Leaders/ServicesManifest ===== */}
  <section class="ateam-intro">
    <div class="awrap">
      <p class="ateam-lede">
        {teamIntroWords.map((w) => (
          <>
            <span class="aword">{w}</span>{" "}
          </>
        ))}
      </p>
    </div>
  </section>

  {/* ===== PAVOL — portrait (right-aligned in its column) + bio ===== */}
  <section class="ateam-pavol">
    <div class="awrap ateam-pavol-grid">
      <figure class="ateam-fig">
        <div class="amedia" data-reveal style="aspect-ratio: 328 / 470">
          <img src="/images/about/pavol.jpg" alt={t.team.pavol.name} loading="lazy" />
        </div>
        <figcaption class="ateam-info" data-reveal>
          <span class="ateam-name">{t.team.pavol.name}</span>
          <span class="ateam-role">{t.team.pavol.role}</span>
        </figcaption>
      </figure>
      <div class="ateam-bio" data-reveal>
        {t.team.pavol.bio.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  {/* ===== TOMÁŠ + DOMINIK — bio left (bottom-aligned to the photos'
      image edge), portrait pair right; the pair unrolls in reading
      order (left first) via the shared row stagger ===== */}
  <section class="ateam-duo">
    <div class="awrap ateam-duo-grid">
      <div class="ateam-bio ateam-duo-bio" data-reveal>
        {t.team.duo.bio.map((p) => <p>{p}</p>)}
      </div>
      <div class="ateam-duo-photos">
        {t.team.duo.members.map((m, i) => (
          <figure class="ateam-fig">
            <div class="amedia" data-reveal style="aspect-ratio: 328 / 470">
              <img src={duoImages[i]} alt={m.name} loading="lazy" />
            </div>
            <figcaption class="ateam-info" data-reveal>
              <span class="ateam-name">{m.name}</span>
              <span class="ateam-role">{m.role}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  {/* ===== NÁŠ TÍM — editorial grid (Figma oNás_V2 3393:216): rows of
      three in a 4-column raster, the empty cell alternating (odd rows
      skip col 3, even rows col 2). Everyone is visible at once — no one
      hides behind a drag. One STATIC portrait per member (the hover
      second-portrait crossfade was removed 2026-07-14, Michal); a member
      without a photo gets the dark placeholder tile. Only ROW 1 gets the
      scroll reveal (`data-reveal` is conditional) — the Works pattern;
      the roster will grow and every row animating read as too much
      (Michal, 2026-07-14). Later rows render visible, parallax stays
      on every photo. ===== */}
  <section class="ateam-grid-sec" aria-label={t.team.galleryLabel}>
    <div class="awrap">
      <h2 class="ateam-label" data-reveal>{t.team.galleryLabel}</h2>
      {memberRows.map((row, ri) => (
        <div class="ateam-grid-row">
          {row.map((m) =>
            m.careers ? (
              <a
                class="ateam-vacancy-link"
                style={`--tcol: ${m.col}`}
                href={CAREERS_URL}
                target="_blank"
                rel="noopener"
              >
                <figure class="ateam-member">
                  <div
                    class="ateam-portrait ateam-portrait--vacancy"
                    data-reveal={ri === 0 || undefined}
                  ></div>
                  <figcaption class="ateam-info" data-reveal={ri === 0 || undefined}>
                    <span class="ateam-name">{m.name}</span>
                    <span class="ateam-role">{m.role}</span>
                  </figcaption>
                </figure>
              </a>
            ) : (
              <figure class="ateam-member" style={`--tcol: ${m.col}`}>
                {m.image ? (
                  <div class="ateam-portrait" data-reveal={ri === 0 || undefined}>
                    <img class="ateam-face" src={m.image} alt={m.name} loading="lazy" />
                  </div>
                ) : (
                  <div
                    class="ateam-portrait ateam-portrait--empty"
                    data-reveal={ri === 0 || undefined}
                  ></div>
                )}
                <figcaption class="ateam-info" data-reveal={ri === 0 || undefined}>
                  <span class="ateam-name">{m.name}</span>
                  <span class="ateam-role">{m.role}</span>
                </figcaption>
              </figure>
            ),
          )}
        </div>
      ))}
    </div>
  </section>

  <div class="awrap"><div class="adivider"></div></div>

  {/* ===== REFERENCIE — "Čo hovoria naši klienti:" (Figma 3407:2…22).
      One slide = project photo (2 grid cols) + 32px quote + the member
      info lockup. The hildenkaira pattern: slides are STACKED in one
      grid cell (section height = the tallest quote, no jumps) and the
      drag gesture swaps them IN PLACE — outgoing fades, incoming rises.
      The 01/05 counter flips with the site's masked-rise motion. No
      auto-rotation; tabindex + arrow keys in about-page.ts. ===== */}
  <section class="atest" aria-label={t.testimonials.label} tabindex="0">
    <div class="awrap">
      <div class="atest-head">
        <h2 class="atest-label" data-reveal>{t.testimonials.label}</h2>
        <p class="atest-counter">
          <span class="atest-counter-mask"
            ><span class="atest-counter-cur" data-testimonial-current aria-live="polite">01</span></span
          ><span>/</span><span>{testimonialCount}</span>
        </p>
      </div>
      <div class="atest-stack" data-testimonials-stack>
        {testimonials.map((item, i) => (
          <article class="atest-slide" aria-hidden={i === 0 ? undefined : "true"}>
            {item.image && (
              <figure class="atest-fig">
                <div class="amedia" data-reveal style="aspect-ratio: 211 / 302">
                  <img src={item.image} alt="" loading="lazy" draggable="false" />
                </div>
              </figure>
            )}
            <div class="atest-body" data-reveal>
              <blockquote class="atest-quote">“&nbsp;&nbsp;{item.quote}</blockquote>
              <div class="ateam-info">
                <span class="ateam-name">{item.name}</span>
                <span class="ateam-role">{item.role}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
    <DragCursor label={dragLabel} />
  </section>

  <div class="awrap"><div class="adivider"></div></div>

  <Footer lang={lang} />
</article>

<style>
  .apage {
    background: var(--bg);
    color: var(--ink);
  }

  .awrap {
    width: 100%;
    max-width: 2464px;
    margin: 0 auto;
    padding-inline: clamp(16px, 2vw, 48px);
  }

  .adivider {
    width: 100%;
    height: 1px;
    background: var(--line);
  }

  /* ===== HERO — same treatment as the project-detail hero ===== */
  .ahero {
    position: relative;
    height: 100vh;
    min-height: 520px;
    overflow: hidden;
  }
  .ahero-media {
    position: absolute;
    inset: 0;
  }
  /* Starts at scale 1.1 — about-page.ts settles it to 1 (intro), then runs
     the Ken Burns yo-yo. */
  .ahero-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.1);
    will-change: transform;
  }
  /* Legibility gradient — same as the detail hero. */
  .ahero-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0.28) 22%,
      rgba(0, 0, 0, 0.04) 48%,
      rgba(0, 0, 0, 0) 66%
    );
  }
  .ahero-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-bottom: clamp(32px, 3.89vw, 64px); /* 56 @1440 */
  }
  .ahero-title {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.28em;
    max-width: 66.11%; /* 915/1384 — wraps to two lines like the Figma */
    font-family: var(--font-sans);
    font-style: normal; /* override the global serif-italic heading rule */
    font-weight: 400; /* Regular — matches the homepage hero title */
    color: #fff;
    font-size: clamp(34px, 4.44vw, 88px); /* 64 @1440 */
    line-height: 1.094; /* 70/64 */
    letter-spacing: 0;
    margin: 0;
  }
  .ahero-title-mask {
    display: inline-block;
    overflow: hidden;
    line-height: inherit;
  }
  /* CSS only hides via opacity — about-page.ts seeds yPercent (the
     matrix-decomposition trap; same note as every hero title). */
  .ahero-title-word {
    display: inline-block;
    opacity: 0;
    will-change: transform, opacity;
  }

  /* ===== INTRO (word-scrub) — same scale as the other page intros ===== */
  .aintro {
    padding-top: clamp(56px, 6.94vw, 140px); /* 100 @1440 */
  }
  .aintro-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(48px, 5.55vw, 120px); /* 80 @1440 */
  }
  .aintro-text {
    font-family: var(--font-sans);
    font-weight: 500;
    max-width: 83%; /* 1150/1384 */
    text-align: center;
    font-size: clamp(26px, 3.33vw, 68px); /* 48 @1440 */
    line-height: 1.25;
    letter-spacing: 0.02em;
    margin: 0;
  }
  .aword {
    color: color-mix(in srgb, var(--ink) calc(var(--reveal, 0) * 100%), var(--ink-faint));
  }

  /* ===== POČIATKY — label left, content right (Figma: label @0,
     content 915 @469 → 33.89% offset of the 1384 grid) ===== */
  .aorigins {
    padding-top: clamp(48px, 5.55vw, 80px); /* 80 @1440 */
  }
  .aorigins-grid {
    display: grid;
    grid-template-columns: auto 66.11%; /* content = 915/1384 */
    justify-content: space-between;
    align-items: start;
  }
  .aorigins-label,
  .ateam-label,
  .atest-label {
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(16px, 1.39vw, 30px); /* 20 @1440 */
    letter-spacing: 0.02em;
    color: var(--ink);
    margin: 0;
  }
  .aorigins-content {
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 5.55vw, 120px); /* 80 @1440 */
    padding-bottom: clamp(48px, 5.55vw, 80px); /* 80 @1440 → photo story below */
  }
  .aorigins-cols {
    display: grid;
    grid-template-columns: 1fr 1fr; /* 446 · 445 of 915 */
    column-gap: clamp(16px, 1.67vw, 32px); /* 24 @1440 */
    align-items: start;
  }
  .aorigins-col p,
  .ateam-bio p {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(16px, 1.39vw, 30px); /* 20 @1440 */
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--ink);
    margin: 0 0 1.4em;
  }
  .aorigins-col p:last-child,
  .ateam-bio p:last-child {
    margin-bottom: 0;
  }

  .aorigins-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 1.39vw, 28px); /* 20 @1440 */
  }
  .amedia {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--surface);
  }
  /* Oversized for the inner parallax — same calibration as the Works
     grid. NO static CSS offset: the scrub in about-page.ts carries the
     -11%-of-frame centering baseline itself (yPercent ±8 around
     -9.0164) — see Works.astro for the full Safari grey-band story. */
  .amedia img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 122%;
    object-fit: cover;
    display: block;
  }
  .aorigins-caption {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(14px, 1.11vw, 22px); /* 16 @1440 */
    line-height: 1.375;
    letter-spacing: 0.02em;
    color: var(--text-mute);
  }

  /* ===== PRÍBEH V OBRAZOCH — Figma: 445 + 680 pair (mid photo offset
     117/1384 from the right edge), then 1147 aligned right. Captions here
     are body-size ink text (20px), not the muted photo-credit style. ===== */
  .astory-row {
    display: flex;
    justify-content: space-between;
