---
/**
 * AboutPage — the /o-nas page (Figma "oNás", node 3227:348). Built section
 * by section as the design lands; current spine:
 *
 *   hero (photo + word-mask title) → word-scrub intro → "Počiatky
 *   ateliéru" (label · two text columns · photo + caption) → photo story →
 *   team word-scrub → Pavol (photo + bio) → Tomáš + Dominik (bio + photo
 *   pair) → "Náš tím" drag carousel → footer
 *
 * Motion in scripts/about-page.ts — everything reuses the site's motion
 * language 1:1:
 *   - Hero: homepage hero choreography (image settle 1.1→1, words at 0.85s,
 *     Ken Burns yo-yo after)
 *   - Intros: per-word colour scrub (--reveal)
 *   - Origins/team texts + photos: clip-path curtain on scroll-in (Works
 *     row-1 pattern); the Tomáš/Dominik pair unrolls in reading order
 *   - Carousel: the project-detail drag gallery (drag-gallery.ts +
 *     DragCursor.astro), same cursor, same behaviour
 */
import Footer from "./Footer.astro";
import DragCursor from "./DragCursor.astro";
import { type Lang } from "../i18n/home";
import { aboutPage } from "../i18n/about-page";
import { projectsUI } from "../i18n/projects";

interface Props {
  lang?: Lang;
}
const { lang = "sk" } = Astro.props;
const t = aboutPage[lang];

const introWords = t.intro.split(" ");
const teamIntroWords = t.team.intro.split(" ");

// Lang-agnostic photos (same convention as the story blocks): duo order
// matches t.team.duo.members (Dominik left, Tomáš right), carousel order
// matches t.team.gallery (team-1…team-5).
const duoImages = ["/images/about/dominik.jpg", "/images/about/tomas.jpg"];
const galleryImages = t.team.gallery.map((_, i) => `/images/about/team-${i + 1}.jpg`);
const dragLabel = projectsUI[lang].dragLabel;
---

<article class="apage">
  {/* ===== HERO — photo + word-mask title (homepage choreography) ===== */}
  <header class="ahero" aria-label={t.heroTitle}>
    <div class="ahero-media">
      <img src="/images/about/hero.jpg" alt="" fetchpriority="high" />
    </div>
    <div class="ahero-scrim" aria-hidden="true"></div>
    <div class="awrap ahero-inner">
      <h1 class="ahero-title">
        {t.heroTitle.split(" ").map((w) => (
          <span class="ahero-title-mask"><span class="ahero-title-word">{w}</span></span>
        ))}
      </h1>
    </div>
  </header>

  {/* ===== INTRO — per-word colour scrub + rule ===== */}
  <section class="aintro">
    <div class="awrap aintro-inner">
      <p class="aintro-text">
        {introWords.map((w) => (
          <>
            <span class="aword">{w}</span>{" "}
          </>
        ))}
      </p>
      <div class="adivider"></div>
    </div>
  </section>

  {/* ===== POČIATKY ATELIÉRU — label · two columns · photo ===== */}
  <section class="aorigins">
    <div class="awrap aorigins-grid">
      <h2 class="aorigins-label" data-reveal>{t.origins.label}</h2>

      <div class="aorigins-content">
        <div class="aorigins-cols">
          <div class="aorigins-col" data-reveal>
            {t.origins.col1.map((p) => <p>{p}</p>)}
          </div>
          <div class="aorigins-col" data-reveal>
            {t.origins.col2.map((p) => <p>{p}</p>)}
          </div>
        </div>

        <figure class="aorigins-figure">
          {/* Curtain reveal on scroll-in — homepage Works row-1 pattern. */}
          <div class="amedia" data-reveal style="aspect-ratio: 915 / 456">
            <img src="/images/about/pociatky.jpg" alt={t.origins.caption} loading="lazy" />
          </div>
          <figcaption class="aorigins-caption" data-reveal>{t.origins.caption}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  {/* ===== PRÍBEH V OBRAZOCH — pair row (tall 445 + mid 680) then the wide
      1147 photo aligned right; every photo reveals with the same curtain +
      caption rise as the "Počiatky" photo above. Divider closes here. ===== */}
  <section class="astory">
    <div class="awrap astory-row">
      <figure class="astory-fig astory-fig--tall">
        <div class="amedia" data-reveal style="aspect-ratio: 445 / 620">
          <img src="/images/about/kontrola.jpg" alt={t.story[0].alt} loading="lazy" />
        </div>
        <figcaption class="astory-caption" data-reveal>{t.story[0].caption}</figcaption>
      </figure>
      <figure class="astory-fig astory-fig--mid">
        <div class="amedia" data-reveal style="aspect-ratio: 680 / 482">
          <img src="/images/about/diskusia.jpg" alt={t.story[1].alt} loading="lazy" />
        </div>
        <figcaption class="astory-caption" data-reveal>{t.story[1].caption}</figcaption>
      </figure>
    </div>
    {/* Second pair — mirrored composition: portrait 563 offset 117 from the
        left edge, landscape 563 flush right (Figma frame "2"). */}
    <div class="awrap astory-row">
      <figure class="astory-fig astory-fig--offset">
        <div class="amedia" data-reveal style="aspect-ratio: 563 / 730">
          <img src="/images/about/model.jpg" alt={t.story[2].alt} loading="lazy" />
        </div>
        <figcaption class="astory-caption" data-reveal>{t.story[2].caption}</figcaption>
      </figure>
      <figure class="astory-fig astory-fig--flush">
        <div class="amedia" data-reveal style="aspect-ratio: 563 / 402">
          <img src="/images/about/vzorky.jpg" alt={t.story[3].alt} loading="lazy" />
        </div>
        <figcaption class="astory-caption" data-reveal>{t.story[3].caption}</figcaption>
      </figure>
    </div>
    <div class="awrap astory-widerow">
      <figure class="astory-fig astory-fig--wide">
        <div class="amedia" data-reveal style="aspect-ratio: 1147 / 584">
          <img src="/images/about/stavba.jpg" alt={t.story[4].alt} loading="lazy" />
        </div>
        <figcaption class="astory-caption" data-reveal>{t.story[4].caption}</figcaption>
      </figure>
    </div>
  </section>

  {/* ===== TÍM — word-scrub intro (Figma "Sekcia 4"): left-aligned, 3em
      editorial indent like Leaders/ServicesManifest ===== */}
  <section class="ateam-intro">
    <div class="awrap">
      <p class="ateam-lede">
        {teamIntroWords.map((w) => (
          <>
            <span class="aword">{w}</span>{" "}
          </>
        ))}
      </p>
    </div>
  </section>

  {/* ===== PAVOL — portrait (right-aligned in its column) + bio ===== */}
  <section class="ateam-pavol">
    <div class="awrap ateam-pavol-grid">
      <figure class="ateam-fig">
        <div class="amedia" data-reveal style="aspect-ratio: 328 / 470">
          <img src="/images/about/pavol.jpg" alt={t.team.pavol.name} loading="lazy" />
        </div>
        <figcaption class="ateam-info" data-reveal>
          <span class="ateam-name">{t.team.pavol.name}</span>
          <span class="ateam-role">{t.team.pavol.role}</span>
        </figcaption>
      </figure>
      <div class="ateam-bio" data-reveal>
        {t.team.pavol.bio.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  {/* ===== TOMÁŠ + DOMINIK — bio left (bottom-aligned to the photos'
      image edge), portrait pair right; the pair unrolls in reading
      order (left first) via the shared row stagger ===== */}
  <section class="ateam-duo">
    <div class="awrap ateam-duo-grid">
      <div class="ateam-bio ateam-duo-bio" data-reveal>
        {t.team.duo.bio.map((p) => <p>{p}</p>)}
      </div>
      <div class="ateam-duo-photos">
        {t.team.duo.members.map((m, i) => (
          <figure class="ateam-fig">
            <div class="amedia" data-reveal style="aspect-ratio: 328 / 470">
              <img src={duoImages[i]} alt={m.name} loading="lazy" />
            </div>
            <figcaption class="ateam-info" data-reveal>
              <span class="ateam-name">{m.name}</span>
              <span class="ateam-role">{m.role}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  {/* ===== NÁŠ TÍM — label + drag carousel: the SAME gallery as the
      project detail (drag-gallery.ts + DragCursor.astro). Portrait/
      landscape items alternate per the Figma; touch falls back to
      native horizontal scroll. ===== */}
  <section class="ateam-gal" data-gallery aria-label={t.team.galleryLabel}>
    <div class="awrap">
      <h2 class="ateam-label" data-reveal>{t.team.galleryLabel}</h2>
    </div>
    <div class="agal-viewport" data-gallery-viewport>
      <div class="agal-track" data-gallery-track>
        {t.team.gallery.map((m, i) => (
          <figure class={`agal-item ${i % 2 ? "agal-item--land" : "agal-item--port"}`}>
            <div class="agal-media" style={`aspect-ratio: ${i % 2 ? "563 / 498" : "328 / 470"}`}>
              <img src={galleryImages[i]} alt={m.name} draggable="false" loading="lazy" />
            </div>
            <figcaption class="ateam-info">
              <span class="ateam-name">{m.name}</span>
              <span class="ateam-role">{m.role}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
    <DragCursor label={dragLabel} />
  </section>

  <div class="awrap"><div class="adivider"></div></div>

  <Footer lang={lang} />
</article>

<style>
  .apage {
    background: var(--bg);
    color: var(--ink);
  }

  .awrap {
    width: 100%;
    max-width: 2464px;
    margin: 0 auto;
    padding-inline: clamp(16px, 2vw, 48px);
  }

  .adivider {
    width: 100%;
    height: 1px;
    background: var(--line);
  }

  /* ===== HERO — same treatment as the project-detail hero ===== */
  .ahero {
    position: relative;
    height: 100vh;
    min-height: 520px;
    overflow: hidden;
  }
  .ahero-media {
    position: absolute;
    inset: 0;
  }
  /* Starts at scale 1.1 — about-page.ts settles it to 1 (intro), then runs
     the Ken Burns yo-yo. */
  .ahero-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.1);
    will-change: transform;
  }
  /* Legibility gradient — same as the detail hero. */
  .ahero-scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0.28) 22%,
      rgba(0, 0, 0, 0.04) 48%,
      rgba(0, 0, 0, 0) 66%
    );
  }
  .ahero-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-bottom: clamp(32px, 3.89vw, 64px); /* 56 @1440 */
  }
  .ahero-title {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.28em;
    max-width: 66.11%; /* 915/1384 — wraps to two lines like the Figma */
    font-family: var(--font-sans);
    font-style: normal; /* override the global serif-italic heading rule */
    font-weight: 400; /* Regular — matches the homepage hero title */
    color: #fff;
    font-size: clamp(34px, 4.44vw, 88px); /* 64 @1440 */
    line-height: 1.094; /* 70/64 */
    letter-spacing: 0;
    margin: 0;
  }
  .ahero-title-mask {
    display: inline-block;
    overflow: hidden;
    line-height: inherit;
  }
  /* CSS only hides via opacity — about-page.ts seeds yPercent (the
     matrix-decomposition trap; same note as every hero title). */
  .ahero-title-word {
    display: inline-block;
    opacity: 0;
    will-change: transform, opacity;
  }

  /* ===== INTRO (word-scrub) — same scale as the other page intros ===== */
  .aintro {
    padding-top: clamp(56px, 6.94vw, 140px); /* 100 @1440 */
  }
  .aintro-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(48px, 5.55vw, 120px); /* 80 @1440 */
  }
  .aintro-text {
    font-family: var(--font-sans);
    font-weight: 500;
    max-width: 83%; /* 1150/1384 */
    text-align: center;
    font-size: clamp(26px, 3.33vw, 68px); /* 48 @1440 */
    line-height: 1.25;
    letter-spacing: 0.02em;
    margin: 0;
  }
  .aword {
    color: color-mix(in srgb, var(--ink) calc(var(--reveal, 0) * 100%), var(--ink-faint));
  }

  /* ===== POČIATKY — label left, content right (Figma: label @0,
     content 915 @469 → 33.89% offset of the 1384 grid) ===== */
  .aorigins {
    padding-top: clamp(48px, 5.55vw, 80px); /* 80 @1440 */
  }
  .aorigins-grid {
    display: grid;
    grid-template-columns: auto 66.11%; /* content = 915/1384 */
    justify-content: space-between;
    align-items: start;
  }
  .aorigins-label,
  .ateam-label {
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(16px, 1.39vw, 30px); /* 20 @1440 */
    letter-spacing: 0.02em;
    color: var(--ink);
    margin: 0;
  }
  .aorigins-content {
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 5.55vw, 120px); /* 80 @1440 */
    padding-bottom: clamp(48px, 5.55vw, 80px); /* 80 @1440 → photo story below */
  }
  .aorigins-cols {
    display: grid;
    grid-template-columns: 1fr 1fr; /* 446 · 445 of 915 */
    column-gap: clamp(16px, 1.67vw, 32px); /* 24 @1440 */
    align-items: start;
  }
  .aorigins-col p,
  .ateam-bio p {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(16px, 1.39vw, 30px); /* 20 @1440 */
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--ink);
    margin: 0 0 1.4em;
  }
  .aorigins-col p:last-child,
  .ateam-bio p:last-child {
    margin-bottom: 0;
  }

  .aorigins-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 1.39vw, 28px); /* 20 @1440 */
  }
  .amedia {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--surface);
  }
  /* Oversized for the inner parallax — same calibration as the Works
     grid. NO static CSS offset: the scrub in about-page.ts carries the
     -11%-of-frame centering baseline itself (yPercent ±8 around
     -9.0164) — see Works.astro for the full Safari grey-band story. */
  .amedia img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 122%;
    object-fit: cover;
    display: block;
  }
  .aorigins-caption {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(14px, 1.11vw, 22px); /* 16 @1440 */
    line-height: 1.375;
    letter-spacing: 0.02em;
    color: var(--text-mute);
  }

  /* ===== PRÍBEH V OBRAZOCH — Figma: 445 + 680 pair (mid photo offset
     117/1384 from the right edge), then 1147 aligned right. Captions here
     are body-size ink text (20px), not the muted photo-credit style. ===== */
  .astory-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    /* 80/80 @1440 — with the neighbours' own 80s this makes 160 of air
       between a caption and the next photo (Figma update: bolo tesné). */
    padding-top: clamp(48px, 5.55vw, 80px);
    padding-bottom: clamp(48px, 5.55vw, 80px);
  }
  .astory-fig {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 1.39vw, 28px); /* 20 @1440 */
  }
  .astory-fig--tall {
    width: 32.15%; /* 445/1384 */
  }
  .astory-fig--mid {
    width: 49.13%; /* 680/1384 */
    margin-right: 8.45%; /* 117/1384 */
  }
  /* Second pair — mirror of the first: same 117 offset, from the LEFT. */
  .astory-fig--offset {
    width: 40.68%; /* 563/1384 */
    margin-left: 8.45%; /* 117/1384 */
  }
  .astory-fig--flush {
    width: 40.68%; /* 563/1384 */
  }
  .astory-widerow {
    display: flex;
    justify-content: flex-end;
    padding-top: clamp(48px, 5.55vw, 80px); /* 80 @1440 */
    padding-bottom: clamp(48px, 5.55vw, 80px); /* 80 @1440 → closing divider */
  }
  .astory-fig--wide {
    width: 82.87%; /* 1147/1384 */
  }
  .astory-caption {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(16px, 1.39vw, 30px); /* 20 @1440 */
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  /* ===== TÍM — word-scrub intro (Figma Sekcia 4: 48px Medium, full
     1384 width, editorial 3em indent like Leaders/ServicesManifest) ===== */
  .ateam-intro,
  .ateam-pavol,
  .ateam-duo {
    padding-block: clamp(48px, 5.55vw, 80px); /* 80 @1440 — the page rhythm */
  }
  .ateam-lede {
    font-family: var(--font-sans);
    font-weight: 500;
    text-indent: 3em;
    font-size: clamp(26px, 3.33vw, 68px); /* 48 @1440 */
    line-height: 1.25;
    letter-spacing: 0.02em;
    margin: 0;
  }

  /* ===== PAVOL — photo column 563 (inner portrait 328 right-aligned),
     bio 446 (Figma: gap 142) ===== */
  .ateam-pavol-grid {
    display: grid;
    grid-template-columns: 40.68% 32.23%; /* 563 · 446 of 1384 */
    column-gap: 10.26%; /* 142/1384 */
    align-items: start;
  }
  .ateam-pavol-grid .ateam-fig {
    width: 58.26%; /* 328/563 */
    margin-left: auto; /* right edge of the photo column */
  }
  .ateam-fig {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 1.39vw, 28px); /* 20 @1440 */
  }
  .ateam-info {
    display: flex;
    flex-direction: column;
    gap: clamp(3px, 0.28vw, 6px); /* 4 @1440 */
  }
  .ateam-name,
  .ateam-role {
    font-family: var(--font-sans);
    letter-spacing: 0.02em;
    line-height: 1.3;
  }
  .ateam-name {
    font-weight: 500;
    font-size: clamp(16px, 1.39vw, 30px); /* 20 @1440 */
    color: var(--ink);
  }
  .ateam-role {
    font-weight: 400;
    font-size: clamp(14px, 1.11vw, 22px); /* 16 @1440 */
    color: var(--text-mute);
  }

  /* ===== TOMÁŠ + DOMINIK — bio left, portrait pair right; the bio's
     bottom padding ≈ the info block below the photos, so the text edge
     aligns with the IMAGE edge (Figma pb-80) ===== */
  .ateam-duo-grid {
    display: grid;
    grid-template-columns: 32.15% 49.13%; /* 445 · 680 of 1384 */
    justify-content: space-between;
    align-items: end;
  }
  .ateam-duo-bio {
    padding-bottom: clamp(48px, 5.55vw, 120px); /* 80 @1440 */
  }
  .ateam-duo-photos {
    display: flex;
    gap: clamp(14px, 1.67vw, 32px); /* 24 @1440 */
  }
  .ateam-duo-photos .ateam-fig {
    flex: 1; /* two equal 328 portraits */
  }

  /* ===== NÁŠ TÍM CAROUSEL — same full-bleed drag track as the project
     gallery (track starts at the gutter, flows off the right edge as a
     drag affordance); items keep their Figma widths (445 portrait /
     563 landscape, capped at design size like .pgal), heights follow
     each item's aspect-ratio, top-aligned. No parallax on the photos
     (static media, like the project gallery). ===== */
  .ateam-gal {
    position: relative;
    padding-top: clamp(48px, 5.55vw, 80px); /* 80 @1440 */
    padding-bottom: clamp(48px, 5.55vw, 80px); /* 80 @1440 → closing divider */
  }
  .ateam-gal .ateam-label {
    margin-bottom: clamp(24px, 2.78vw, 56px); /* 40 @1440 */
  }
  .agal-viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .agal-track {
    display: flex;
    align-items: flex-start;
    gap: clamp(14px, 1.67vw, 32px); /* 24 @1440 */
    padding-inline: clamp(16px, 2vw, 48px); /* align first photo to the gutter */
    width: max-content;
    will-change: transform;
    cursor: grab;
  }
  .agal-track.is-dragging {
    cursor: grabbing;
  }
  .agal-item {
    flex: 0 0 auto;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(14px, 1.39vw, 28px); /* 20 @1440 */
  }
  .agal-item--port {
    width: clamp(220px, 30.9vw, 445px); /* 445 @1440 */
  }
  .agal-item--land {
    width: clamp(280px, 39.1vw, 563px); /* 563 @1440 */
  }
  .agal-media {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--surface);
  }
  .agal-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Touch devices — native horizontal scroll instead of Draggable
     (the cursor hides itself in DragCursor.astro). */
  @media (hover: none) {
    .agal-viewport {
      overflow-x: auto;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .agal-viewport::-webkit-scrollbar {
      display: none;
    }
    .agal-track {
      cursor: auto;
    }
    .agal-item {
      scroll-snap-align: start;
    }
  }

  /* ===== Reveal initial states — hidden from first paint; about-page.ts
     animates and strips the attributes. Label + columns use the SAME
     clip-path curtain as the Services rows (one motion family with the
     photo); only the caption keeps the small fade-up. ===== */
  .amedia[data-reveal],
  .aorigins-label[data-reveal],
  .aorigins-col[data-reveal],
  .ateam-bio[data-reveal],
  .ateam-label[data-reveal] {
    clip-path: inset(100% 0 0 0);
  }
  .aorigins-caption[data-reveal],
  .astory-caption[data-reveal],
  .ateam-info[data-reveal] {
    opacity: 0;
    transform: translateY(16px);
  }

  /* =============================================================
     Responsive — tablet scales via clamp/%; mobile (≤767) stacks.
     ============================================================= */
  @media (max-width: 767px) {
    .ahero {
      height: 78vh;
      min-height: 460px;
    }
    .ahero-title {
      max-width: 100%;
