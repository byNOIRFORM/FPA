      <li><a class={`nav-flip${activeCls("projects")}`} href={projectsHref} data-text={t.nav.links.projects} aria-current={ariaCur("projects")}><span>{t.nav.links.projects}</span></a></li>
      <li><a class={`nav-flip${activeCls("services")}`} href={servicesLink} data-text={t.nav.links.services} aria-current={ariaCur("services")}><span>{t.nav.links.services}</span></a></li>
    </ul>
    <a class={`nav-cta${anim}`} href="#kontakt" data-open-contact>
      <span class="nav-cta-text">{t.nav.cta}</span>
      <svg
        class="nav-cta-arrow"
        width="16"
        height="10"
        viewBox="0 0 16 10"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M0 5 H14 M10 1 L14 5 L10 9" />
      </svg>
    </a>
  </div>

  <button class={`nav-menu${anim}`} type="button" data-open-menu aria-label={t.nav.menuAria}>
    <span class="nav-flip" data-text={t.nav.menu}><span>{t.nav.menu}</span></span>
  </button>
</nav>

<style>
  /* ===== Bar =====
     Fixed to the viewport. Transparent + white text over the hero/photo;
     the .is-scrolled state (toggled in scripts/nav.ts) swaps to the cream
     panel once the boundary element has scrolled past the top. The
     hide/show transform is GSAP-driven (auto-hide); these CSS transitions
     only cover the theme swap. */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(24px, 3.33vw, 72px);
    padding: clamp(16px, 1.53vw, 33px) clamp(16px, 2vw, 48px);
    color: #fff;
    background: transparent;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(14px, 1.11vw, 22px);
    line-height: 1;
    letter-spacing: 0.02em;
    will-change: transform;
    transition:
      background 420ms cubic-bezier(0.65, 0, 0.35, 1),
      color 420ms cubic-bezier(0.65, 0, 0.35, 1),
      box-shadow 420ms cubic-bezier(0.65, 0, 0.35, 1),
      padding 420ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  .nav.is-scrolled {
    background: var(--bg);
    color: var(--ink);
    padding: clamp(12px, 1.11vw, 24px) clamp(16px, 2vw, 48px);
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: clamp(40px, 5.55vw, 120px);
  }

  .nav-logo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    text-decoration: none;
    color: inherit;
    line-height: 1;
  }

  /* The official mark (inline SVG, currentColor → follows the nav ink
     in every state/theme). Heights mirror the old two-line text lockup:
     2 × clamp(20px,1.67vw,36px) + 2px gap, and its is-scrolled shrink. */
  .nav-logo-mark {
    display: block;
    height: clamp(42px, 3.47vw, 74px);
    width: auto;
    aspect-ratio: 166.6 / 125.7;
    transition: height 420ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  .nav.is-scrolled .nav-logo-mark {
    height: clamp(38px, 2.92vw, 62px);
  }

  .nav-clock {
    font-size: clamp(14px, 1.11vw, 22px);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .nav-langs {
    display: flex;
    gap: clamp(10px, 0.83vw, 18px);
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-lang {
    color: inherit;
    text-decoration: none;
  }

  /* Current language — de-emphasised + inert, exactly like the active
     page link (.nav-link--active). */
  .nav-lang--active {
    opacity: 0.55;
    pointer-events: none;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: clamp(40px, 5.55vw, 120px);
  }

  .nav-links {
    display: flex;
    gap: clamp(10px, 0.83vw, 18px);
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: inherit;
    text-decoration: none;
    line-height: 1;
    display: inline-block;
  }

  /* Current-page link (subpage variant) — de-emphasised + inert. */
  .nav-link--active {
    opacity: 0.55;
    pointer-events: none;
  }

  /* Text flip hover — visible text slides up, a duplicate (::after,
     content: attr(data-text)) rises from below. Pure CSS. */
  /* Flip mask. ORIGINAL metrics (line-height 1.15, vertical-align top) so
     the bar's alignment is byte-identical to the long-approved layout —
     do NOT change these, they set every .nav-flip box height.

     The clipping is clip-path (not overflow:hidden), for two reasons:
       1. Switzer's glyphs overrun the tight 1.15 line box (descenders of
          j/y/ž below, cap diacritics above) — overflow:hidden cut them.
          The negative ±0.18em inset lets the full glyphs show at rest.
       2. WebKit doesn't reliably clip composited children with
          overflow:hidden alone — that's what leaked fragments mid-flip.
          clip-path clips them dependably (and there's no permanent
          will-change to force compositing at rest).

     The duplicate (::after) shares the exact box (inset: 0) and both
     texts travel ±140% — beyond the widened clip window — so neither
     text's overhanging glyphs ever peek at rest or post-flip. */
  .nav-flip {
    position: relative;
    display: inline-block;
    clip-path: inset(-0.18em 0);
    line-height: 1.15;
    vertical-align: top;
    color: inherit;
    text-decoration: none;
  }

  .nav-flip span {
    display: inline-block;
    transition: transform 480ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  .nav-flip::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    transform: translateY(140%);
    transition: transform 480ms cubic-bezier(0.65, 0, 0.35, 1);
  }

  .nav-flip:hover span {
    transform: translateY(-140%);
  }
  .nav-flip:hover::after {
    transform: translateY(0);
  }

  .nav-cta {
