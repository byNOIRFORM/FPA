---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutPage from "../components/AboutPage.astro";
import { aboutPage } from "../i18n/about-page";
---

{/* About — no intro loader; nav is transparent over the hero photo
    (boundary = .ahero) and turns cream once scrolled past. */}
<BaseLayout
  title={aboutPage.sk.metaTitle}
  description={aboutPage.sk.intro}
  loader={false}
  navVariant="sub"
  navActive="about"
  navBoundary=".ahero"
  lang="sk"
>
  <AboutPage lang="sk" />
</BaseLayout>
