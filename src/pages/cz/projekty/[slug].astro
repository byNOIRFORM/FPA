---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ProjectPage from "../../../components/ProjectPage.astro";
import { getProjectDetails, getProjectDetail } from "../../../lib/projects";

export async function getStaticPaths() {
  return (await getProjectDetails()).map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const locale = (await getProjectDetail(slug!))!.locales.cz;
---

<BaseLayout
  title={`${locale.title} — Fotta Popadič`}
  description={locale.intro}
  loader={false}
  navVariant="sub"
  navBoundary=".phero"
  lang="cz"
>
  <ProjectPage lang="cz" slug={slug!} />
</BaseLayout>
