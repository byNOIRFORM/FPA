---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectsPage from "../../components/ProjectsPage.astro";
import { projectsPageUI } from "../../i18n/projects";
---

{/* Projects listing — a plain grid on the cream background, so the nav is the
    solid cream panel from the top (no hero boundary to watch). */}
<BaseLayout
  title="Projekty — Fotta // Popadič"
  description={projectsPageUI.sk.intro}
  loader={false}
  navVariant="sub"
  navActive="projects"
  lang="sk"
>
  <ProjectsPage lang="sk" />
</BaseLayout>
